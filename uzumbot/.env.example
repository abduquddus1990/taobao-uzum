# Bu faylni ".env" nomi bilan nusxalang va to'ldiring. Bu namunaga HAQIQIY kalit yozmang!

# @BotFather dan olingan token
BOT_TOKEN=

# Adminlar: telegram_id:ism, vergul bilan. Birinchisi — asosiy ega
ADMINS=111111111:Ism1,222222222:Ism2

# Google AI Studio kaliti (ixtiyoriy — AI yordamchi uchun)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# healthchecks.io ping manzili (ixtiyoriy — elektr o'chganini bilish uchun)
HEALTHCHECK_URL=
HEARTBEAT_SECONDS=300

# Mini App: lokal port. WEBAPP_URL bo'sh bo'lsa, bot cloudflared orqali o'zi HTTPS manzil oladi
WEBAPP_PORT=8088
WEBAPP_URL=
TUNNEL=cloudflared

# Har kuni shu soatda (Toshkent vaqti) baza zaxira nusxasi egaga yuboriladi
BACKUP_HOUR=23
